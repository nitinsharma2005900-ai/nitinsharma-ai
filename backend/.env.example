# =================================================================
# Advanced RAG Agent - Environment Configuration Example
# =================================================================
# Copy this file to .env and fill in your API credentials:
# cp .env.example .env

# Google Gemini API Key (Required for live Gemini LLM generation)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Cohere API Key (Required for live Cohere Embed & Cohere ReRank v3)
# Get a free trial key from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# Mem0 API Key (Optional for cloud Mem0; local persistent memory store is enabled by default)
# Get a key from: https://app.mem0.ai/dashboard/api-keys
MEM0_API_KEY=your_mem0_api_key_here

# Qdrant Vector Database (Optional; local persistent vector storage is used by default)
# For managed Qdrant Cloud:
QDRANT_URL=
QDRANT_API_KEY=

# Pipeline Configuration
PARENT_CHUNK_SIZE=1000
PARENT_CHUNK_OVERLAP=100
CHILD_CHUNK_SIZE=200
CHILD_CHUNK_OVERLAP=30
RRF_K=60
TOP_K_CANDIDATES=20
TOP_N_RERANK=5
RELEVANCE_SCORE_THRESHOLD=0.01
COHERE_RERANK_MODEL=rerank-english-v3.0
GEMINI_MODEL=gemini-3.5-flash-lite

# Set to true to run in offline test mode (uses deterministic embeddings & reranker)
OFFLINE_TEST_MODE=false
